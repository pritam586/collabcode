# All values are optional; the defaults below are used when a value is missing or blank.
# Invalid values stop the server at start-up with a message naming the bad setting.

PORT=4000
# development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed to connect. Outside production
# (NODE_ENV != production) any http://localhost:<port> origin is also allowed.
CLIENT_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy so rate limits see the real client IP:
# true, a hop count such as 1, or a subnet list such as loopback,10.0.0.0/8.
# TRUST_PROXY=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty (needs dev dependencies) | json. Defaults to pretty in development, json otherwise.
# LOG_FORMAT=json

CODE_RUNNER_ENABLED=true
# Optional: pin internal or approved Docker images for the native code runner.
# JAVA_RUNNER_IMAGE=eclipse-temurin:21-jdk-alpine
# CPP_RUNNER_IMAGE=gcc:14.2.0
# PYTHON_RUNNER_IMAGE=python:3.12-alpine
# TYPESCRIPT_RUNNER_IMAGE=node:22-alpine
# DOCKER_BIN=docker
