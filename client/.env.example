# Where the API and Socket.io server live. Read at build time.
#   unset or blank  -> http://localhost:4000 (local development)
#   same-origin     -> the page's own origin, when a reverse proxy forwards /api and /socket.io
#                      to the server (the Docker setup does this)
#   any other URL   -> used as-is, e.g. https://api.collab.example.com
VITE_SERVER_URL=http://localhost:4000
